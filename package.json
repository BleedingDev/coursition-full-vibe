{
  "name": "coursition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "cloudflare:build": "MODERNJS_DEPLOY=cloudflare modern build && MODERNJS_DEPLOY=cloudflare modern deploy --skip-build",
    "cloudflare:deploy": "node ./scripts/validate-cloudflare-release.mjs && pnpm run cloudflare:build && node ./scripts/deploy-cloudflare.mjs",
    "cloudflare:preview": "node ./scripts/preview-cloudflare.mjs",
    "zephyr:build": "MODERNJS_DEPLOY=zephyr modern build",
    "db:backfill:coursition": "node ./scripts/backfill-coursition-drafts.mjs",
    "db:generate": "drizzle-kit generate",
    "serve": "modern serve",
    "release:check": "pnpm typecheck && pnpm effect-diagnostics:check && pnpm i18n:check && pnpm test && pnpm skills:check && node ./scripts/validate-ultramodern.mjs",
    "test": "rstest run",
    "posttest": "rstest run --config rstest.d1.config.mts",
    "test:d1": "rstest run --config rstest.d1.config.mts",
    "typecheck": "node --input-type=module -e \"import fs from 'node:fs'; import { execFileSync, spawnSync } from 'node:child_process'; const bin = execFileSync('effect-tsgo', ['get-exe-path'], { encoding: 'utf8' }).trim(); if (process.platform !== 'win32') fs.chmodSync(bin, 0o755); const result = spawnSync(bin, ['--noEmit', '-p', 'tsconfig.json'], { stdio: 'inherit' }); process.exit(result.status ?? 1);\"",
    "effect-diagnostics:check": "node ./scripts/check-effect-diagnostics.mjs",
    "i18n:check": "node ./scripts/check-i18n-strings.mjs",
    "skills:install": "node ./scripts/bootstrap-agent-skills.mjs",
    "skills:check": "node ./scripts/bootstrap-agent-skills.mjs --check",
    "postinstall": "node ./scripts/bootstrap-agent-skills.mjs && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || true)",
    "ultramodern:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm effect-diagnostics:check && pnpm i18n:check && pnpm test && pnpm skills:check && node ./scripts/validate-ultramodern.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@ax-llm/ax": "^22.0.2",
    "@better-auth/drizzle-adapter": "^1.6.13",
    "@effect/platform-node": "4.0.0-beta.94",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mdxeditor/editor": "4.0.2",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.5.0-ultramodern.98",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.5.0-ultramodern.98",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.5.0-ultramodern.98",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.5.0-ultramodern.98",
    "@tanstack/react-router": "1.170.17",
    "@techsio/ui-kit": "0.22.1",
    "better-auth": "1.6.13",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.94",
    "file-type": "^22.0.1",
    "i18next": "26.3.6",
    "kysely": "0.28.17",
    "mime-types": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "@effect/tsgo": "0.16.3",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.5.0-ultramodern.98",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.5.0-ultramodern.98",
    "@modern-js/code-tools": "npm:@bleedingdev/modern-js-code-tools@3.5.0-ultramodern.98",
    "@modern-js/create": "npm:@bleedingdev/modern-js-create@3.5.0-ultramodern.98",
    "@modern-js/tsconfig": "npm:@bleedingdev/modern-js-tsconfig@3.5.0-ultramodern.98",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.10.1",
    "lefthook": "^2.1.9",
    "miniflare": "4.20260708.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.9.3",
    "wrangler": "4.109.0",
    "zephyr-modernjs-plugin": "1.2.1",
    "zephyr-rspack-plugin": "1.2.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "modernjs": {
    "preset": "presetUltramodern",
    "packageSource": {
      "strategy": "install",
      "config": "./.modernjs/ultramodern-package-source.json"
    }
  }
}
