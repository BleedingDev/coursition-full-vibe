{
  "name": "coursition",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "cloudflare:build": "MODERNJS_DEPLOY=cloudflare modern build && MODERNJS_DEPLOY=cloudflare modern deploy && node ./scripts/prepare-cloudflare-output.mjs",
    "cloudflare:deploy": "ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && pnpm dlx wrangler@latest deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && pnpm dlx wrangler@latest dev --config .output/wrangler.json",
    "serve": "modern serve",
    "test": "rstest run",
    "typecheck": "node --input-type=module -e \"import fs from 'node:fs'; import { execFileSync, spawnSync } from 'node:child_process'; const bin = execFileSync('effect-tsgo', ['get-exe-path'], { encoding: 'utf8' }).trim(); if (process.platform !== 'win32') fs.chmodSync(bin, 0o755); const result = spawnSync(bin, ['--noEmit', '-p', 'tsconfig.json'], { stdio: 'inherit' }); process.exit(result.status ?? 1);\"",
    "effect-diagnostics:check": "node ./scripts/check-effect-diagnostics.mjs",
    "i18n:check": "node ./scripts/check-i18n-strings.mjs",
    "skills:install": "node ./scripts/bootstrap-agent-skills.mjs",
    "skills:check": "node ./scripts/bootstrap-agent-skills.mjs --check",
    "postinstall": "node ./scripts/bootstrap-agent-skills.mjs && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || true)",
    "ultramodern:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm effect-diagnostics:check && pnpm i18n:check && pnpm test && pnpm skills:check && node ./scripts/validate-ultramodern.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@ax-llm/ax": "^22.0.2",
    "@effect/platform-node": "4.0.0-beta.78",
    "@mdxeditor/editor": "4.0.2",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.2.0-ultramodern.112",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.2.0-ultramodern.112",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.2.0-ultramodern.112",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.2.0-ultramodern.112",
    "@tanstack/react-router": "1.170.15",
    "@techsio/ui-kit": "0.4.1",
    "better-auth": "1.6.13",
    "data-urls": "^7.0.0",
    "effect": "4.0.0-beta.78",
    "file-type": "^22.0.1",
    "i18next": "26.3.1",
    "mime-types": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.14.0",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.2.0-ultramodern.112",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.2.0-ultramodern.112",
    "@modern-js/code-tools": "npm:@bleedingdev/modern-js-code-tools@3.2.0-ultramodern.112",
    "@modern-js/tsconfig": "npm:@bleedingdev/modern-js-tsconfig@3.2.0-ultramodern.112",
    "@rstest/core": "0.10.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/data-urls": "^3.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260606.1",
    "happy-dom": "^20.10.1",
    "lefthook": "^2.1.9",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "ultracite": "7.8.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.5.2 <11.6.0"
  },
  "packageManager": "pnpm@11.5.2",
  "modernjs": {
    "preset": "presetUltramodern",
    "packageSource": {
      "strategy": "install",
      "config": "./.modernjs/ultramodern-package-source.json"
    }
  }
}
