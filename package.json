{
  "name": "coursition",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "reset": "npx rimraf node_modules ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "serve": "modern serve",
    "test": "rstest run",
    "typecheck": "node -e \"const fs = require('node:fs'); const { execFileSync, spawnSync } = require('node:child_process'); const bin = execFileSync('effect-tsgo', ['get-exe-path'], { encoding: 'utf8' }).trim(); if (process.platform !== 'win32') fs.chmodSync(bin, 0o755); const result = spawnSync(bin, ['--noEmit', '-p', 'tsconfig.json'], { stdio: 'inherit' }); process.exit(result.status ?? 1);\"",
    "i18n:check": "node ./scripts/check-i18n-strings.mjs",
    "skills:install": "node ./scripts/bootstrap-agent-skills.mjs",
    "skills:check": "node ./scripts/bootstrap-agent-skills.mjs --check",
    "postinstall": "node ./scripts/bootstrap-agent-skills.mjs && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && lefthook install || true)",
    "ultramodern:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test && pnpm skills:check && node ./scripts/validate-ultramodern.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@ax-llm/ax": "^22.0.2",
    "@mdxeditor/editor": "4.0.2",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.2.0-ultramodern.83",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.2.0-ultramodern.83",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.2.0-ultramodern.83",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.2.0-ultramodern.83",
    "@tanstack/react-router": "1.170.8",
    "@techsio/ui-kit": "0.4.1",
    "better-auth": "1.6.13",
    "i18next": "26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.13.0",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.2.0-ultramodern.83",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.2.0-ultramodern.83",
    "@modern-js/tsconfig": "npm:@bleedingdev/modern-js-tsconfig@3.2.0-ultramodern.83",
    "@rstest/core": "0.10.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "happy-dom": "^20.9.0",
    "lefthook": "^2.1.9",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "ultracite": "7.7.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.5.1 <11.6.0"
  },
  "packageManager": "pnpm@11.5.1",
  "modernjs": {
    "preset": "presetUltramodern",
    "packageSource": {
      "strategy": "install",
      "config": "./.modernjs/ultramodern-package-source.json"
    }
  }
}
